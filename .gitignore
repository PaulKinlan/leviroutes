node_modules/
# No dist/: the package ships src/routes.js and there is no build step (leviroutes-o71, leviroutes-x8g).
# tools/verify-package.mjs rejects a build script, build output in files[] and build output in the
# published tree, so anything reappearing here is a defect inside the package.
*.log
.DS_Store
coverage/
.nyc_output/

# leviroutes-f9n: a committed .npmrc can disarm the whole publish gate (ignore-scripts=true
# skips prepublishOnly, so no test or verify-package step runs and nothing says so). The
# publish gate refuses such a file, but only when it runs - so keep the file out of git.
.npmrc
